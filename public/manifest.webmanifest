{
  "name": "Inkwell",
  "short_name": "Inkwell",
  "start_url": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": "navigate-existing" },
  "background_color": "#F6F1E7",
  "theme_color": "#1C1A17",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Capture an idea",
      "short_name": "Capture",
      "description": "Talk and it lands on today's page",
      "url": "./?capture=voice",
      "icons": [
        {
          "src": "capture-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "capture-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf"
          ]
        }
      ]
    }
  }
}
